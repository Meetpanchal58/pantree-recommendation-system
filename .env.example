# Copy to .env for local runs (never commit .env). On Cloud Run these come from
# scripts/deploy_cloudrun.sh (environment variables) and Secret Manager (secrets).

# Public origin of the storefront, exactly as the browser sees it. HTTPS in production.
PUBLIC_APP_URL=http://127.0.0.1:8000
# development: local defaults; production: requires the Google client, SESSION_SECRET and HTTPS.
APP_ENV=development

# Sign in with Google: an OAuth client ("Web application") in Google Cloud console ->
# APIs & Services -> Credentials. Authorised redirect URI: <PUBLIC_APP_URL>/auth/google/callback
# Leave both empty locally to get a development-only sign-in form instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the short-lived OAuth state cookie. At least 32 random characters; required in production.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Live database. Empty = the local SQLite file (webapp/pantree_app.db).
# A Postgres connection string (e.g. Neon, with connection pooling) keeps accounts, carts,
# orders and activity across restarts and redeploys.
DATABASE_URL=

# 0 on small hosts: skip the collaborative-filtering and sentence-transformer models.
PANTREE_HEAVY_RECOMMENDATIONS=1
# 1 = mirror every write to the local DuckDB analytics file (off on Cloud Run).
PANTREE_LIVE_MIRROR=1
